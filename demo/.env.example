# Copy to demo/.env (gitignored). Run demos with:
#   bun --env-file=.env --env-file=demo/.env demo/<script>.ts

# Throwaway GitHub account with TOTP 2FA, for github-2fa.ts
GITHUB_USER=
GITHUB_PASSWORD=

# LLM for agent.ts — set ONE of these:
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Model override for agent.ts (any OpenRouter id works; this free one is verified)
DEMO_MODEL=minimax/minimax-m3:free
DEMO_MAX_STEPS=18

# Telegram bot for handraise-telegram (BotFather)
TELEGRAM_BOT_TOKEN=
