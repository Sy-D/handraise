{
  "name": "handraise",
  "version": "0.0.1",
  "description": "Human-in-the-loop handoff for Solari cloud browsers. Your agent already knows when it's stuck — handraise lets it raise its hand.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sy-D/handraise.git"
  },
  "keywords": [
    "solari",
    "human-in-the-loop",
    "hitl",
    "browser-automation",
    "ai-agents",
    "2fa",
    "captcha",
    "handoff",
    "playwright"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && oxlint",
    "test:e2e": "bun --env-file=.env e2e/handoff.e2e.ts"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.2",
    "@solarisdk/sdk": "^0.1.2",
    "playwright-core": "^1.62.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@oxlint/plugins": "1.80.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "bun-types": "^1.4.0",
    "oxlint": "1.80.0",
    "typescript": "^5.7.2"
  }
}
